# Laisser VITE_API_URL absent (défaut /api) ou en RELATIF uniquement.
# Une URL absolue cross-site casse le cookie XSRF-TOKEN de Sanctum (419).
# Voir src/constants/axiosInstance.ts pour le détail.
VITE_API_URL=/api

# Dev uniquement : désactive l'authentification et les permissions sur les modules.
VITE_AUTH_DISABLED=false
