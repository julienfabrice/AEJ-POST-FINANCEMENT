# Laisser VITE_API_URL absent (défaut /api) ou en RELATIF uniquement.
# Une URL absolue cross-site casse le cookie XSRF-TOKEN de Sanctum (419).
# Voir src/constants/axiosInstance.ts pour le détail.
VITE_API_URL=/api

# Dev uniquement : bypass des permissions (can() renvoie toujours true) pendant
# que le backend permissions n'est pas prêt. NE JAMAIS mettre à true en prod.
VITE_BYPASS_PERMISSIONS=false
